# agent-worker env — the Robot loop, Evaluator, Refine, conflict resolver, visual capture
# (D-044, PD-266; generalized D-045, PD-282).
#
# Copy to the deploy host as /volume1/docker/personal-dashboard/agent-worker.env and fill in the
# tokens. It is loaded as the agent-worker container's env_file (docker-compose.egress.yml) and kept
# SEPARATE from the web app's .env, so these tokens never reach the user-facing web process.
# Values below are what production runs, except ROBOT_DISPATCH_ENABLED (see there). Defaults for
# anything not set live in apps/agent-worker/src/shared/config.ts.
#
# Changes take effect when the container is recreated (an image update or `docker compose up -d`).
# Docker reads `#` only at the START of a line: never put a comment after a value.
#
# DATA_DIR, AGENT_WORKER_CHECKOUT_DIR and the HTTP(S)_PROXY vars are set by the compose file —
# don't set them here.

# ── Credentials ────────────────────────────────────────────────────────────────────────────────

# Claude auth for every agent session (Robot, Evaluator, Refine). Reaches api.anthropic.com only
# through the squid egress proxy; readable in-container but not exfiltratable off-allowlist.
# Set exactly ONE (if both are present the API key wins):
#  - CLAUDE_CODE_OAUTH_TOKEN — your Claude subscription token (`claude setup-token`). No extra
#    billing, but it shares the subscription's quota. Production uses this; refresh it with
#    `pbpaste | ssh steve@NAS 'bash /volume1/docker/personal-dashboard/set-claude-token.sh'`.
#  - ANTHROPIC_API_KEY — metered pay-as-you-go, billed separately (a fresh key starts at $0: add
#    credits in the Console, or you'll get "Credit balance is too low").
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# READ-ONLY GitHub token: clones/pulls the grounding checkout and polls PR state.
# Fine-grained PAT with Contents: Read on the repo (or a classic public_repo PAT).
GITHUB_READ_TOKEN=

# GitHub token the Robot (and the conflict resolver) push branches and open PRs with. Kept out of
# the coding agent's own environment.
ROBOT_GITHUB_TOKEN=

# Fine-grained PAT with Commit statuses read+write only. The worker uses it to post the
# review-gate status on PRs, and the auto-merge workflow reacts to that status. A read-only token
# fails silently with a 403 (seen 2026-11-20).
REVIEW_GATE_TOKEN=

# ── Robot loop ─────────────────────────────────────────────────────────────────────────────────

# Master switch for the Robot loop. 1 = picks up queued tickets; anything else = picks up nothing.
# (The nav's Loop switch is a separate, runtime pause on top of this.)
# Production: 1. Starts at 0 here so a fresh deploy doesn't start spending before you've checked it.
ROBOT_DISPATCH_ENABLED=0

# Which queued tickets the Robot may pick up.
#   empty      = every eligible queued ticket (normal running)
#   NONE       = pick up nothing (stops new work without touching ROBOT_DISPATCH_ENABLED)
#   429,431    = only these numeric ticket ids (the id field, not PD-NNN)
ROBOT_ALLOWLIST=

# Most Robot runs at the same time.
ROBOT_CONCURRENCY=1

# Loop-wide spend ceiling: total Robot turns allowed in a rolling 24h window (PD-463). When it's
# reached the loop pauses itself until you turn it back on. Code default 500.
ROBOT_BUDGET_TURNS=2000

# The unprivileged user and group that the coding agent, npm ci, verify and screenshot capture
# run as.
ROBOT_CODING_UID=1500
ROBOT_CODING_GID=1500

# Running on defaults — uncomment to override:
# Progress check (PD-964): every CHECKPOINT_WINDOW_TURNS turns the loop judges the last window. A
# run that is progressing continues; a stalled, looping or drifting one parks for Continue/Restart.
# CHECKPOINT_TOTAL_TURNS is the hard cap per episode, even for a run still progressing.
# CHECKPOINT_WINDOW_TURNS=25
# CHECKPOINT_TOTAL_TURNS=200
# Same tool call, or same error, this many times in one window parks the run. Default 4.
# CHECKPOINT_REPEAT_LIMIT=4
# Model for the progress judge. Default: AGENT_WORKER_MODEL.
# CHECKPOINT_JUDGE_MODEL=
# Pause the whole loop after this many different tickets in a row fail in a way a retry won't fix
# (the circuit breaker, D-107). Default 3; 0 disables.
# ROBOT_BREAKER_FAILURES=3
# How often a running rework checks whether its PR merged, closed, or was pushed to by someone
# else, and stops if so (PD-926). Milliseconds; default 120000 (2 min); 0 disables.
# ROBOT_SUPERSEDE_CHECK_MS=120000

# ── Evaluator (reviews PRs and posts review-gate) ──────────────────────────────────────────────

# Reviews each PR's new head with the code (and security) lens and posts review-gate; a ship
# opens the gate. Also reviews non-Robot PRs unless EVALUATOR_ALL_PRS=0. Off unless set.
EVALUATOR_ENABLED=1

# Running on defaults — uncomment to override:
# Times the Evaluator may send a PR back for rework per hand-off before leaving it to you
# (PD-761). Default 2. Planned: 5, once rounds are cheaper (PD-419).
# EVALUATOR_MAX_ROUNDS=2
# The Robot takes over one of YOUR session PRs the Evaluator sent back, once nobody has pushed to
# it for EVALUATOR_ADOPT_IDLE_MS (PD-913). Default on; 0 = never (you just get a needs-human).
# EVALUATOR_ADOPT=1
# EVALUATOR_ADOPT_IDLE_MS=1800000
# Also review PRs the Robot didn't open (PD-712). Default on; 0 = Robot PRs only.
# EVALUATOR_ALL_PRS=1
# The security lens, alongside the code lens. Default on; 0 = code lens only.
# EVALUATOR_SECURITY_ENABLED=1

# ── Other jobs ─────────────────────────────────────────────────────────────────────────────────

# Starts a Refine session on every new unrefined ticket, at most REFINE_OPEN_CAP open at once
# (default 15). Off unless set.
REFINE_AUTOSTART_ENABLED=1

# Every 5 min, merges main into conflicting PRs where the conflict is mechanical (generated
# decision files, append-only hunks), then has the Evaluator review them again. Sends anything
# else back to the Robot. Never rebases. Off unless set (PD-774, D-099).
CONFLICT_RESOLVER_ENABLED=1
# CONFLICT_RESOLVER_INTERVAL_MS=300000

# Every 2 min, builds each in-review PR's head, screenshots the routes it changed in headless
# Chromium, and attaches them to the PR and its Visual check card. Needs DASHBOARD_PUBLIC_URL.
# Off unless set (PD-773). While off, the visual-check gate skips itself and each PR says
# "capture is off" (PD-793, PD-794).
VISUAL_CAPTURE_ENABLED=1

# The dashboard's address as your browser reaches it (tailnet/LAN). Screenshot links in PR
# comments are built from it.
DASHBOARD_PUBLIC_URL=http://192.168.68.50:8088

# Lets maintenance holds open (PD-498, D-081, D-082, D-085): a hold stops new Robot dispatch while
# a maintenance window runs. Holds are opened by hand from Dev Ops → Jobs (no scheduled jobs exist
# since PD-560). Unset means NO holds at all — the Dev Ops button inserts its request and nothing
# ever services it.
MAINTENANCE_HOLD_ENABLED=1
# The coordinator's tick rate (not how often holds happen). Default 60000.
# MAINTENANCE_HOLD_POLL_MS=60000

# Running on defaults — uncomment to override:
# Hourly job tracing each bug fix back to the PR that introduced it, for Velocity (PD-916).
# Default on; 0 disables.
# SZZ_ENABLED=1
# The model every agent session uses. Default claude-opus-4-8.
# AGENT_WORKER_MODEL=claude-opus-4-8
# How often the grounding checkout pulls main. Default 300000 (5 min).
# AGENT_WORKER_PULL_INTERVAL_MS=300000
